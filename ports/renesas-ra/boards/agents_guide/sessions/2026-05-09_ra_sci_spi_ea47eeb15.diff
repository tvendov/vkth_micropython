-    // Match the Renesas FSP SCI SPI bitrate calculation when MDDR is used.
-    brr = (int32_t)PCLK / divisor - 1;
-    if (brr < 0) {
-        brr = 0;
-    } else if (brr > UINT8_MAX) {
