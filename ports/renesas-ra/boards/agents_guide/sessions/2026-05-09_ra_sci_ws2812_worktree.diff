 bool ra_sci_ws2812_find_ch(uint32_t data_pin, uint8_t *ch) {
     uint32_t found_ch;
     uint32_t af;
     bool ok = ra_sci_ws2812_find_pin_af_ch(data_pin, &found_ch, &af);
     if (ok && ch != NULL) {
         *ch = (uint8_t)found_ch;
     }
     return ok;
 }
 
