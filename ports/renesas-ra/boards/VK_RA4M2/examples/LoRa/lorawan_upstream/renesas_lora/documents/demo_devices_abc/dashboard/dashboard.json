          ]},
          { "matcher": { "id": "byName", "options": "temp" }, "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" }}
          ]},
          { "matcher": { "id": "byName", "options": "humidity" }, "properties": [{ "id": "unit", "value": "percent" }] },
          { "matcher": { "id": "byName", "options": "battery" }, "properties": [{ "id": "unit", "value": "mvolt" }] }
        ]
      },
      "targets": [{
        "refId": "A", "datasource": "chirpstack-pg", "format": "table",
        "rawSql": "SELECT fcnt, rssi, snr, dr, temp_c100/100.0 AS temp, hum_p2/2.0 AS humidity, battery_mv AS battery FROM demo.uplinks WHERE deveui='70B3D57ED0070001' ORDER BY ts DESC LIMIT 1",
