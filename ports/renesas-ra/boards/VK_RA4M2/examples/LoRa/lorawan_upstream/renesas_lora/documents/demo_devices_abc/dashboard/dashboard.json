        "rawSql": "SELECT u.dl_rssi AS \"DL RSSI\", u.dl_snr AS \"DL SNR\", d.margin AS \"Margin (DevStatus)\", d.dr AS \"Current DR\" FROM demo.uplinks u JOIN device d ON encode(d.dev_eui,'hex') = lower(u.deveui) WHERE u.deveui='70B3D57ED0070003' ORDER BY u.ts DESC LIMIT 1",
        "rawQuery": true
      }]
    },
    {
      "id": 62, "type": "stat",
      "title": "★ Class C — TX power (board → gateway)",
      "datasource": "loki",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "value_and_name", "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 7 }
          ]}
        }
      },
      "targets": [{
        "refId": "A", "datasource": "loki",
        "expr": "{job=\"chirpstack\"} |= \"LinkADRReq acknowledged\" |= \"70b3d57ed0070003\" | regexp \"tx_power_index=(?P<tx_power>\\\\d+)\" | unwrap tx_power",
        "queryType": "instant",
        "maxLines": 1
      }]
    },

