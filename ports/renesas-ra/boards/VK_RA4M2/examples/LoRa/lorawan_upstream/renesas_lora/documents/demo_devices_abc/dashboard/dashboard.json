        "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      },
      "targets": [{
        "refId": "A", "datasource": "loki",
        "expr": "{job=\"chirpstack\"} != \"Metrics saved\" != \"event/stats\" != \"TenantService\"",
        "queryType": "range", "maxLines": 200
