{
  "uid": "lorawan-demo",
  "title": "LoRaWAN Class A/B/C Live Demo",
  "tags": ["lorawan", "demo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "2s",
  "time": { "from": "now-2h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "row", "title": "Devices status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 10, "type": "stat", "title": "Class A — 70B3D57ED0070001",
      "datasource": "chirpstack-pg",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "rssi" }, "properties": [
              { "id": "unit", "value": "dBm" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                  { "color": "red", "value": null },
                  { "color": "orange", "value": -120 },
                  { "color": "yellow", "value": -110 },
                  { "color": "green", "value": -100 }
              ]}}
          ]},
          { "matcher": { "id": "byName", "options": "snr" }, "properties": [
              { "id": "unit", "value": "dB" },
