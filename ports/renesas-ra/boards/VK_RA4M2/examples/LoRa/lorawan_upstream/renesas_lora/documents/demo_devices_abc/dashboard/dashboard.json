      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{
        "refId": "A", "datasource": "loki",
        "expr": "{job=\"chirpstack\", unit=\"chirpstack.service\"} |~ \"(?i)join_request|f_type=|MIC|Invalid|Error|ADRReq|DevStatus|tx_power\"",
        "queryType": "range", "maxLines": 100
      }]
    },

