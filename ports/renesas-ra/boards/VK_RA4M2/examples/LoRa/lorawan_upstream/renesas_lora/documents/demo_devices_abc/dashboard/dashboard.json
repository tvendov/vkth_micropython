    {
      "id": 41, "type": "logs",
      "title": "★ Live ChirpStack server logs",
      "datasource": "loki",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 33 },
      "options": {
        "showTime": true, "showLabels": false, "showCommonLabels": false,
