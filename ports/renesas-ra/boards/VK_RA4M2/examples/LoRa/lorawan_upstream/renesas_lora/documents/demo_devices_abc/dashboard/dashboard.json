      "options": { "legend": { "displayMode": "table", "calcs": ["last", "min", "mean"] } },
      "targets": [{
        "refId": "A", "datasource": "chirpstack-pg", "format": "time_series",
        "rawSql": "SELECT ts AS time, ('Class ' || class) AS metric, rssi AS value FROM demo.uplinks WHERE $__timeFilter(ts) ORDER BY ts",
        "rawQuery": true
      }]
    },
    {
      "id": 21, "type": "timeseries", "title": "DR per device",
