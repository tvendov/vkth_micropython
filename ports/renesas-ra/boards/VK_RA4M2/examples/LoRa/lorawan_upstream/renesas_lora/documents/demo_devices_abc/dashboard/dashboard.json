            { "color": "yellow", "value": 700 },
            { "color": "red", "value": 1500 }
        ]}}
      },
      "targets": [{
        "refId": "A", "datasource": "chirpstack-pg", "format": "table",
        "rawSql": "SELECT last_dl_lat_ms FROM demo.uplinks WHERE class='C' AND last_dl_lat_ms IS NOT NULL AND last_dl_lat_ms > 0 ORDER BY ts DESC LIMIT 1",
        "rawQuery": true
      }]
    },
    {
      "id": 31, "type": "stat",
      "title": "Total uplinks / class",
      "datasource": "chirpstack-pg",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 26 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": true }, "orientation": "horizontal", "colorMode": "value", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue" }] } } },
      "targets": [{
        "refId": "A", "datasource": "chirpstack-pg", "format": "table",
        "rawSql": "SELECT class, COUNT(*) AS uplinks FROM demo.uplinks GROUP BY class ORDER BY class",
        "rawQuery": true
      }]
    },
    {
      "id": 32, "type": "barchart",
      "title": "Channel hopping (8 EU868 channels)",
      "datasource": "chirpstack-pg",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 26 },
      "options": { "orientation": "horizontal", "showValue": "auto", "stacking": "none" },
      "targets": [{
        "refId": "A", "datasource": "chirpstack-pg", "format": "table",
        "rawSql": "SELECT to_char(channel_freq / 1000000.0, 'FM999.9') || ' MHz' AS channel, COUNT(*) AS uplinks FROM demo.uplinks WHERE channel_freq IS NOT NULL AND $__timeFilter(ts) GROUP BY channel_freq ORDER BY channel_freq",
        "rawQuery": true
      }]
    },

